layout {
	default_tab_template {
		pane size=1 borderless=true {
			// zellij は URL のハッシュを名前にして wasm をキャッシュし、そのファイルが
			// 存在する限り再取得しない (zellij-utils/src/downloader.rs)。URL が固定の
			// "latest/download" では初回取得版が永久に使われ続けるため、更新するには
			// キャッシュを消す必要がある。検知と手順の通知は
			// routine/generic_zjstatus_update.sh が行う。
			plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
				format_left   "{mode} #[fg=#45BEC9,bold]{command_hostinfo} | {tabs}"
				format_center ""
				// progressinfo は転送中のみ出力し、区切りの " | " も自分で前置する
				format_right  " | {command_claudeinfo}{command_progressinfo} | {command_batteryinfo} {command_cpuload} {datetime}"
				format_space  "#[bg=#677589] "

				border_enabled  "false"
				border_char     "─"
				border_format   "#[fg=#6C7086]{char}"
				border_position "top"

				// hide_frame_for_single_pane "true"  // zjstatus#174 / zellij#4978 のチラつき回避のため無効化

				mode_normal	"#[bg=#2E6C9E] "
				mode_locked	"#[bg=#E28C36][LOCKED] "
				mode_resize	"#[bg=#3DB88B][RESIZE] "
				mode_pane	"#[bg=#3DB88B][PANE] "
				mode_tab	"#[bg=#3DB88B][TAB] "
				mode_scroll	"#[bg=#9CC3E2][SCROLL] "
				mode_prompt	"#[bg=#E28C36][PROMPT] "
				mode_tmux	"#[bg=#E28C36][{name}] "
				mode_default_to_mode "tmux"

				tab_normal   "#[fg=#45BEC9,bg=#677589]/ {name} \\"
				tab_active   "#[bg=#45BEC9,bold]/ {name} \\"

				command_claudeinfo_command "bash -c \"$HOME/dotfiles/script/claude_code_status.sh\""
				command_claudeinfo_format  "{stdout}"
				command_claudeinfo_interval 60
				command_claudeinfo_rendermode "dynamic"

				command_progressinfo_command "bash -c \"$HOME/dotfiles/script/progress_info.sh zjstatus\""
				command_progressinfo_format  "{stdout}"
				command_progressinfo_interval 10
				command_progressinfo_rendermode "dynamic"

				command_hostinfo_command "bash -c \"$HOME/dotfiles/script/host_and_connect.sh\""
				command_hostinfo_format  "{stdout}"
				command_hostinfo_interval 0
				command_hostinfo_rendermode "static"

				command_batteryinfo_command "bash -c \"$HOME/dotfiles/script/battery_info.sh\""
				command_batteryinfo_format  "{stdout}"
				command_batteryinfo_interval 60
				command_batteryinfo_rendermode "static"

				command_cpuload_command "bash -c \"$HOME/dotfiles/script/cpuload.sh zjstatus\""
				command_cpuload_format  "{stdout}{stderr}"
				command_cpuload_interval 15
				command_cpuload_rendermode "dynamic"

				datetime        "#[bg=#677589,fg=#eaf0f6,bold]{format}"
				datetime_format "%Y-%m-%d %H:%M"
				datetime_timezone "Asia/Tokyo"
			}
		}
		children
		pane size=2 borderless=true {
			plugin location="zellij:status-bar"
		}
	}

	// swap layout (Alt+[ / Alt+] で巡回)。
	// 組み込みの default.swap.kdl は「組み込みの default レイアウト」専用で、
	// 自前の default.kdl を置いた時点で読まれなくなる (layout.rs: swap_layout_and_path は
	// 隣の default.swap.kdl しか探さない)。ここに直接書けば default_tab_template
	// (= 上の zjstatus バー) が自動で適用されるので、swap ファイルは分けない。
	// 中身は `zellij setup --dump-swap-layout default` の tiled 部分を、
	// tab_template "ui" ではなく default_tab_template を使う形 (ui → tab) に直したもの。
	// なお config.kdl で auto_layout false にしてあるため、ペインを開閉しても
	// 勝手に組み替わらず、Alt+[ / Alt+] を押した時だけ切り替わる。
	// 名前は zellij の split_direction (vertical = 縦の仕切り線 = 左右分割) ではなく
	// 「ペインがどう並んで見えるか」に合わせてある。
	//   vertical   → 上下に 1 列で積む       (最大 8)
	//   horizontal → 左右に 1 行で並べる     (最大 8)
	//   grid       → 田の字                  (最大 4)
	//   stacked    → 左 1 枚 + 右をスタック  (5 枚以上)
	// 9 枚以上では vertical/horizontal/grid は該当なしになるので stacked に回る。
	swap_tiled_layout name="vertical" {
		tab max_panes=8 {
			pane split_direction="horizontal" {
				children
			}
		}
	}

	swap_tiled_layout name="horizontal" {
		tab max_panes=8 {
			pane split_direction="vertical" {
				children
			}
		}
	}

	swap_tiled_layout name="grid" {
		tab max_panes=4 {
			pane split_direction="horizontal" {
				pane split_direction="vertical" { children; }
				pane split_direction="vertical" { pane; pane; }
			}
		}
	}

	swap_tiled_layout name="stacked" {
		tab min_panes=5 {
			pane split_direction="vertical" {
				pane
				pane stacked=true { children; }
			}
		}
	}
}
